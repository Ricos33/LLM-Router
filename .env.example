# ==========================================
# LLM Router Environment Configuration
# ==========================================

# Gateway Server
PORT=8000
HOST=0.0.0.0
DEBUG=false

# Classifier Settings
CLASSIFIER_MODE=mock              # 'mock' (rule-based) or 'jev' (TypeSafe AI - coming soon)
CLASSIFIER_CONFIDENCE_THRESHOLD=0.70
JEV_API_KEY=                      # TypeSafe AI API Key (pending access)
JEV_API_BASE_URL=https://api.typesafe.ai/v1

# Cheap LLM Backend (Default: Local Ollama)
CHEAP_PROVIDER=ollama             # 'ollama' or 'openai_compatible'
CHEAP_API_BASE_URL=http://localhost:11434/v1
CHEAP_API_KEY=ollama              # Ollama doesn't require an API key
CHEAP_MODEL=llama3.2:3b
CHEAP_PROMPT_PRICE_PER_M=0.15     # Estimated $/1M input tokens (or 0.00 for local)
CHEAP_COMPLETION_PRICE_PER_M=0.60 # Estimated $/1M output tokens (or 0.00 for local)

# Frontier LLM Backend (OpenAI / OpenRouter / Groq / Anthropic OpenAI-compat)
FRONTIER_PROVIDER=openai_compatible
FRONTIER_API_BASE_URL=https://api.openai.com/v1
FRONTIER_API_KEY=sk-demo-replace-with-your-real-key
FRONTIER_MODEL=gpt-4o
FRONTIER_PROMPT_PRICE_PER_M=5.00     # Estimated $/1M input tokens
FRONTIER_COMPLETION_PRICE_PER_M=15.00 # Estimated $/1M output tokens

# Fallback / Simulation Mode
# If true, the router returns simulated completions if upstream LLM providers are unreachable
SIMULATE_FALLBACK=true

# Metrics & Database
DATABASE_URL=sqlite:///./data/metrics.sqlite3
