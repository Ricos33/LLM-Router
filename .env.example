# ==========================================
# LLM Router Environment Configuration
# ==========================================

# Gateway Server
PORT=8000
HOST=0.0.0.0
DEBUG=false

# Classifier Settings
CLASSIFIER_MODE=mock              # 'mock' (rule-based heuristic) or 'jev' (TypeSafe AI System One)
CLASSIFIER_CONFIDENCE_THRESHOLD=0.70
JEV_API_KEY=                      # TypeSafe AI API Key from https://console.typesafe.ai
JEV_API_BASE_URL=https://api.typesafe.ai/v1 # Base URL for TypeSafe API (calls /v1/systemone)
JEV_MODEL=jev-latest              # Jev model alias (jev-latest) or versioned ID (e.g. jev-1.13.0)
JEV_TIMEOUT=5.0                   # HTTP timeout in seconds (System One inference is sub-100ms)


# Cheap LLM Backend (Default: Local Ollama)
CHEAP_PROVIDER=ollama             # 'ollama' or 'openai_compatible'
CHEAP_API_BASE_URL=http://localhost:11434/v1
CHEAP_API_KEY=ollama              # Ollama doesn't require an API key
CHEAP_MODEL=llama3.2:3b
CHEAP_PROMPT_PRICE_PER_M=0.15     # Estimated $/1M input tokens (or 0.00 for local)
CHEAP_COMPLETION_PRICE_PER_M=0.60 # Estimated $/1M output tokens (or 0.00 for local)

# Frontier LLM Backend (OpenAI / OpenRouter / Groq / Anthropic)
FRONTIER_PROVIDER=openai             # 'openai', 'anthropic', or 'openai_compatible'
FRONTIER_API_BASE_URL=https://api.openai.com/v1
FRONTIER_API_KEY=sk-demo-replace-with-your-real-key
FRONTIER_MODEL=gpt-4o
FRONTIER_PROMPT_PRICE_PER_M=5.00     # Estimated $/1M input tokens
FRONTIER_COMPLETION_PRICE_PER_M=15.00 # Estimated $/1M output tokens

# OpenAI Specific (for demo setup)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# Anthropic Specific (for demo setup)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-6

# Agy Backend (Local Antigravity CLI)
AGY_ENABLED=false
AGY_BINARY_PATH=~/workspace/cli-tools/bin/agy
AGY_TIMEOUT=60.0
# JSON mapping for tiers with model and optional CLI reasoning effort (low|medium|high|max)
AGY_TIER_MAP={"cheap": {"model": "gemini-3.8-flash-low", "effort": "low"}, "medium": {"model": "gemini-3.1-pro-high", "effort": "high"}, "frontier": {"model": "claude-opus-4-6-thinking", "effort": null}}
AGY_PROMPT_PRICE_PER_M=0.00
AGY_COMPLETION_PRICE_PER_M=0.00

# Medium Tier Pricing (if non-agy medium backend used)
MEDIUM_PROMPT_PRICE_PER_M=1.00
MEDIUM_COMPLETION_PRICE_PER_M=3.00

# Fallback / Simulation Mode
# If true, the router returns simulated completions if upstream LLM providers are unreachable
SIMULATE_FALLBACK=true

# Metrics & Database
DATABASE_URL=sqlite:///./data/metrics.sqlite3
